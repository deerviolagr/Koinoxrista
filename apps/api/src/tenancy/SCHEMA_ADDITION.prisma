model VotingEligibilityRule {
  id               String   @id @default(uuid())
  buildingId       String
  /// GENERAL | STRUCTURAL | FINANCIAL — category of decision
  category         String
  /// e.g. ["OWNER"] or ["OWNER","TENANT"]
  allowedTypes     String[]
  requiresMillimes Boolean  @default(true)
  createdAt        DateTime @default(now())

  building Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@unique([buildingId, category])
  @@index([buildingId])
}
