{
  "name": "@polykatoikia/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start --port 8081",
    "android": "expo start --android --port 8081",
    "ios": "expo start --ios --port 8081",
    "web": "expo start --web --port 8081",
    "build": "expo export --clear --max-workers 1 --platform web --output-dir dist/export",
    "export": "expo export --clear --max-workers 1 --platform web --output-dir dist/export",
    "test": "vitest run --config vitest.config.mjs"
  },
  "dependencies": {
    "@expo/metro-config": "~0.18.11",
    "@expo/metro-runtime": "~3.2.3",
    "@babel/runtime": "^7.24.0",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "expo": "~51.0.39",
    "expo-constants": "~16.0.2",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-web": "~0.19.13"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "babel-preset-expo": "~11.0.15",
    "vitest": "^4.0.8"
  }
}
