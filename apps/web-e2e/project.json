{
  "name": "web-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/web-e2e/src",
  "implicitDependencies": ["web"],
  "targets": {
    "e2e": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/apps/web-e2e/playwright.config.mts",
        { "externalDependencies": ["@playwright/test"] }
      ],
      "outputs": [
        "{workspaceRoot}/dist/.playwright/apps/web-e2e/test-output",
        "{workspaceRoot}/dist/.playwright/apps/web-e2e/playwright-report"
      ],
      "options": {
        "cwd": "apps/web-e2e",
        "command": "pnpm exec playwright test --config=playwright.config.mts"
      }
    },
    "e2e-ci": {
      "executor": "nx:run-commands",
      "cache": false,
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/apps/web-e2e/playwright.config.mts",
        { "externalDependencies": ["@playwright/test"] }
      ],
      "outputs": [
        "{workspaceRoot}/dist/.playwright/apps/web-e2e/test-output",
        "{workspaceRoot}/dist/.playwright/apps/web-e2e/playwright-report"
      ],
      "options": {
        "cwd": "apps/web-e2e",
        "command": "pnpm exec playwright test --config=playwright.config.mts",
        "env": { "CI": "true" }
      }
    }
  }
}
