# PostgreSQL (local Docker via docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/polykatoikiaos?schema=public"

# Auth — production requires three distinct random secrets (32+ chars each).
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_2FA_SECRET=""

# Viva Wallet PSP (demo environment)
PSP_VIVA_BASE_URL="https://demo.vivapayments.com"
PSP_VIVA_CLIENT_ID=""
PSP_VIVA_CLIENT_SECRET=""

# Email reminders (Resend). Empty key → console driver (logs instead of sending).
RESEND_API_KEY=""
MAIL_FROM="no-reply@polykatoikiaos.gr"

# Public base URL of the web app (used in payment links / emails)
APP_BASE_URL="http://localhost:4200"

# Web Push (Phase 7). Missing keys → console push driver.
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@koinoxrista-os.gr"

# Error tracking (optional). Empty -> disabled.
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"

# Security (Phase 13)
# Comma-separated allowed browser origins for CORS, e.g. "http://localhost:4200,https://app.example.gr".
# Unset in development -> allow all; production startup rejects an unset/empty value.
CORS_ORIGINS="http://localhost:4200"
# Swagger UI at /api/docs: auto-enabled outside production; set to 1 to force-enable in production.
SWAGGER_ENABLED=""
# Rate limiting (requests per window) applied globally via ThrottlerGuard.
THROTTLE_LIMIT="100"
# Rate-limit window in milliseconds.
THROTTLE_TTL_MS="60000"

# International PSPs (P0-2). STRIPE_SECRET_KEY enables Stripe card/bank rails
# for non-Greek markets (US/CA/MX/EU); MERCADOPAGO_ACCESS_TOKEN enables Mercado
# Pago Checkout Pro (BR PIX, MX SPEI, AR/CL/CO/PE). Missing keys → sandbox/mock
# driver (mirrors the Viva console pattern).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
MERCADOPAGO_ACCESS_TOKEN=""

# AADE myDATA e-invoicing (Phase 8). MYDATA_MODE=live submits to the real API;
# live mode fails fast unless user id + subscription key are set.
MYDATA_MODE="offline"
# Endpoint override; defaults to the sandbox https://mydatapi.aade.gr/staging
MYDATA_BASE_URL=""
MYDATA_USER_ID=""
MYDATA_CLIENT_SECRET=""
MYDATA_SUBSCRIPTION_KEY=""

# SMS/Viber outbound notifications (commercial wave 1). SMS_MODE=http requires
# a gateway endpoint; anything else (or unset) logs messages to the console.
SMS_MODE="console"
# Gateway endpoint; supports {to} and {text} URL placeholders, otherwise POSTs JSON {to,text}.
SMS_HTTP_URL=""
# Optional raw Authorization header value, e.g. "Bearer xyz".
SMS_HTTP_AUTH=""

# Open-banking feed reconciliation (commercial wave 2). offline generates a
# deterministic fixture feed; gocardless calls the GoCardless Bank Account Data API.
OPENBANKING_MODE="offline"
GC_SECRET_ID=""
GC_SECRET_KEY=""
GC_BASE_URL=""

# Marketplace take-rate (commercial wave 3). Rate in basis points (400 = 4%),
# cap in integer cents (50000 = €500). Invalid values fall back to defaults.
COMMISSION_RATE_BPS="400"
COMMISSION_CAP_CENTS="50000"
# Public web app base URL used to build referral links.
WEB_APP_URL=""
# Product analytics (build-time; compiled into web environments). Empty = disabled.
POSTHOG_KEY=""
POSTHOG_HOST="https://eu.i.posthog.com"

# Document storage (S3-compatible). STORAGE_DRIVER=local (default) writes to DOCS_DIR;
# set STORAGE_DRIVER=s3 and S3_BUCKET to persist to S3/R2/MinIO (SSE-AES256).
# S3_ENDPOINT is needed for MinIO/R2 (e.g. https://<account>.r2.cloudflarestorage.com).
STORAGE_DRIVER="local"
DOCS_DIR=".data/uploads"
S3_BUCKET=""
S3_REGION="us-east-1"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PREFIX="documents"
S3_FORCE_PATH_STYLE="false"

# Assistant LLM (building-management copilot). LLM_PROVIDER selects the driver:
# auto (default; first fully-configured provider), openai, anthropic, or
# openai-compatible (Ollama, vLLM, LM Studio, any OpenAI-compatible gateway).
# Missing keys → console driver (logs instead of calling a hosted model).
LLM_PROVIDER="auto"
# Local AI (Ollama). Start: ollama serve, then ollama pull llama3.1
LLM_API_URL="http://localhost:11434/v1/chat/completions"
LLM_API_KEY="ollama"  # Ollama ignores the key; any non-empty value works
LLM_MODEL="llama3.1"
# Hosted providers (native drivers): OPENAI_API_KEY/OPENAI_MODEL (OpenAI),
# ANTHROPIC_API_KEY/ANTHROPIC_MODEL (Anthropic), or a generic OpenAI-compatible
# gateway via LLM_API_URL/LLM_API_KEY/LLM_MODEL.
OPENAI_API_KEY=""
OPENAI_MODEL=""
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=""
# Local-only guard for Greek deployments: when true, hosted LLM is never called
# (Ollama/Meltemi or console fallback only; GDPR: no data leaves the VPS).
AI_LOCAL_ONLY="false"
# pgvector RAG (optional): set true to use BGE-M3 embeddings in Postgres
PGVECTOR_ENABLED="false"
EMBEDDING_MODEL="bge-m3"
AI_TOKEN_BUDGET_PER_BUILDING="50000"
